{
  "manifest_version": 3,
  "name": "JM Routes Importador",
  "version": "0.1.0",
  "description": "Importa a rota aberta do Mercado Livre para o JMRoutes.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JM Routes Importador",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://envios.adminml.com/*",
    "https://jmroutes.app/*",
    "https://www.jmroutes.app/*"
  ]
}
